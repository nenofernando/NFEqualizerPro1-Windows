<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>NF - Stressor</title>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.txt" mime-type="text/plain"/>
    <pkg-ref id="com.nfaudiotools.stressor.vst3"/>
    <pkg-ref id="com.nfaudiotools.stressor.au"/>
    <pkg-ref id="com.nfaudiotools.stressor.docs"/>
    <options customize="allow" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.nfaudiotools.stressor.vst3"/>
            <line choice="com.nfaudiotools.stressor.au"/>
            <line choice="com.nfaudiotools.stressor.docs"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.nfaudiotools.stressor.vst3" title="VST3 Plug-in" description="Installs the VST3 format into /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.nfaudiotools.stressor.vst3"/>
    </choice>
    <pkg-ref id="com.nfaudiotools.stressor.vst3" version="1.0.0" onConclusion="none">NFStressor-VST3.pkg</pkg-ref>
    <choice id="com.nfaudiotools.stressor.au" title="Audio Unit (AU)" description="Installs the AU format into /Library/Audio/Plug-Ins/Components.">
        <pkg-ref id="com.nfaudiotools.stressor.au"/>
    </choice>
    <pkg-ref id="com.nfaudiotools.stressor.au" version="1.0.0" onConclusion="none">NFStressor-AU.pkg</pkg-ref>
    <choice id="com.nfaudiotools.stressor.docs" title="Manual (English + Portugues)" description="Installs the PDF manual, in English and Portugues, into /Users/Shared/NF Audio Tools/NF - Stressor/Manual." selected="true" enabled="false">
        <pkg-ref id="com.nfaudiotools.stressor.docs"/>
    </choice>
    <pkg-ref id="com.nfaudiotools.stressor.docs" version="1.0.0" onConclusion="none">NFStressor-Docs.pkg</pkg-ref>
</installer-gui-script>
