<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>NF Tape Machine</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <pkg-ref id="com.nfaudio.nftapemachine.vst3"/>
    <pkg-ref id="com.nfaudio.nftapemachine.au"/>
    <pkg-ref id="com.nfaudio.nftapemachine.docs"/>
    <options customize="allow" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.nfaudio.nftapemachine.vst3"/>
            <line choice="com.nfaudio.nftapemachine.au"/>
            <line choice="com.nfaudio.nftapemachine.docs"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.nfaudio.nftapemachine.vst3" title="VST3 Plug-in" description="Installs the VST3 format into /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.nfaudio.nftapemachine.vst3"/>
    </choice>
    <pkg-ref id="com.nfaudio.nftapemachine.vst3" version="0.1.0" onConclusion="none">NFTapeMachine-VST3.pkg</pkg-ref>
    <choice id="com.nfaudio.nftapemachine.au" title="Audio Unit (AU)" description="Installs the AU format into /Library/Audio/Plug-Ins/Components.">
        <pkg-ref id="com.nfaudio.nftapemachine.au"/>
    </choice>
    <pkg-ref id="com.nfaudio.nftapemachine.au" version="0.1.0" onConclusion="none">NFTapeMachine-AU.pkg</pkg-ref>
    <choice id="com.nfaudio.nftapemachine.docs" title="Manual (English + Portugues)" description="Installs the PDF manual, in English and Portugues, into /Users/Shared/NF Audio Tools/NF Tape Machine/Manual." selected="true" enabled="false">
        <pkg-ref id="com.nfaudio.nftapemachine.docs"/>
    </choice>
    <pkg-ref id="com.nfaudio.nftapemachine.docs" version="0.1.0" onConclusion="none">NFTapeMachine-Docs.pkg</pkg-ref>
</installer-gui-script>
