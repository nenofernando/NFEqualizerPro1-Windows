<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>NF White Delay</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <pkg-ref id="com.nfaudiotools.nfwhitedelay.vst3"/>
    <pkg-ref id="com.nfaudiotools.nfwhitedelay.au"/>
    <pkg-ref id="com.nfaudiotools.nfwhitedelay.aax"/>
    <pkg-ref id="com.nfaudiotools.nfwhitedelay.docs"/>
    <options customize="always" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.nfaudiotools.nfwhitedelay.vst3"/>
            <line choice="com.nfaudiotools.nfwhitedelay.au"/>
            <line choice="com.nfaudiotools.nfwhitedelay.aax"/>
            <line choice="com.nfaudiotools.nfwhitedelay.docs"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.nfaudiotools.nfwhitedelay.vst3" title="VST3 Plug-in" description="Installs the VST3 format into /Library/Audio/Plug-Ins/VST3. Recommended for most DAWs (Cubase, Ableton Live, Studio One, Reaper, FL Studio, etc)." selected="true">
        <pkg-ref id="com.nfaudiotools.nfwhitedelay.vst3"/>
    </choice>
    <pkg-ref id="com.nfaudiotools.nfwhitedelay.vst3" version="1.0.0" onConclusion="none">NFWhiteDelay-VST3.pkg</pkg-ref>
    <choice id="com.nfaudiotools.nfwhitedelay.au" title="Audio Unit (AU)" description="Installs the AU format into /Library/Audio/Plug-Ins/Components. For Logic Pro, GarageBand and other AU hosts." selected="false">
        <pkg-ref id="com.nfaudiotools.nfwhitedelay.au"/>
    </choice>
    <pkg-ref id="com.nfaudiotools.nfwhitedelay.au" version="1.0.0" onConclusion="none">NFWhiteDelay-AU.pkg</pkg-ref>
    <choice id="com.nfaudiotools.nfwhitedelay.aax" title="AAX Plug-in" description="Installs the AAX format into /Library/Application Support/Avid/Audio/Plug-Ins. For Pro Tools." selected="false">
        <pkg-ref id="com.nfaudiotools.nfwhitedelay.aax"/>
    </choice>
    <pkg-ref id="com.nfaudiotools.nfwhitedelay.aax" version="1.0.0" onConclusion="none">NFWhiteDelay-AAX.pkg</pkg-ref>
    <choice id="com.nfaudiotools.nfwhitedelay.docs" title="Manual (English)" description="Installs the PDF manual into /Users/Shared/NF Audio Tools/NF White Delay/Manual." selected="true" enabled="false">
        <pkg-ref id="com.nfaudiotools.nfwhitedelay.docs"/>
    </choice>
    <pkg-ref id="com.nfaudiotools.nfwhitedelay.docs" version="1.0.0" onConclusion="none">NFWhiteDelay-Docs.pkg</pkg-ref>
</installer-gui-script>
